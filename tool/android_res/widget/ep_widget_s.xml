<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2: only FrameLayout / LinearLayout / TextView / ImageView (all RemoteViews-safe) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ep_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ep_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="EcoPoint"
                android:scaleType="fitCenter"
                android:src="@drawable/ep_widget_logo" />
                <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:text="" />
                <LinearLayout
                android:id="@+id/ep_widget_streak_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:id="@+id/ep_widget_flame"
                    android:src="@drawable/ep_widget_flame" />

                <TextView
                    android:id="@+id/ep_widget_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="vertical">
                <TextView
                android:id="@+id/ep_widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                
                android:layout_marginStart="0dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:text="EcoPoint"
                android:textAllCaps="true"
                android:textColor="#80FFFFFF"
                android:textSize="9sp" />
                <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ep_widget_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="#FFFFFFFF"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/ep_widget_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="EP"
                    android:textColor="#FFC8F23A"
                    android:textSize="12sp" />
            </LinearLayout>
                <LinearLayout
                android:id="@+id/ep_widget_bar_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/ep_widget_seg_off">
                        <LinearLayout
                            android:id="@+id/ep_widget_seg_0"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ep_widget_seg_on"
                            android:visibility="gone" />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/ep_widget_seg_off">
                        <LinearLayout
                            android:id="@+id/ep_widget_seg_1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ep_widget_seg_on"
                            android:visibility="gone" />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/ep_widget_seg_off">
                        <LinearLayout
                            android:id="@+id/ep_widget_seg_2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ep_widget_seg_on"
                            android:visibility="gone" />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/ep_widget_seg_off">
                        <LinearLayout
                            android:id="@+id/ep_widget_seg_3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ep_widget_seg_on"
                            android:visibility="gone" />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/ep_widget_seg_off">
                        <LinearLayout
                            android:id="@+id/ep_widget_seg_4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ep_widget_seg_on"
                            android:visibility="gone" />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/ep_widget_seg_off">
                        <LinearLayout
                            android:id="@+id/ep_widget_seg_5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ep_widget_seg_on"
                            android:visibility="gone" />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/ep_widget_seg_off">
                        <LinearLayout
                            android:id="@+id/ep_widget_seg_6"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ep_widget_seg_on"
                            android:visibility="gone" />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/ep_widget_seg_off">
                        <LinearLayout
                            android:id="@+id/ep_widget_seg_7"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ep_widget_seg_on"
                            android:visibility="gone" />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/ep_widget_seg_off">
                        <LinearLayout
                            android:id="@+id/ep_widget_seg_8"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ep_widget_seg_on"
                            android:visibility="gone" />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/ep_widget_seg_off">
                        <LinearLayout
                            android:id="@+id/ep_widget_seg_9"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ep_widget_seg_on"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/ep_widget_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            </LinearLayout>
    </LinearLayout>
</FrameLayout>
