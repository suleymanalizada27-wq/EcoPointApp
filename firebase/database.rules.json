{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "prefs": {
          ".write": "auth != null && auth.uid === $uid",
          "notifyActivity": { ".validate": "newData.isBoolean()" },
          "notifyNews": { ".validate": "newData.isBoolean()" },
          "notifyOffers": { ".validate": "newData.isBoolean()" },
          "notifyFewer": { ".validate": "newData.isBoolean()" },
          "notifyMissions": { ".validate": "newData.isBoolean()" },
          "notifyTips": { ".validate": "newData.isBoolean()" },
          "notifyBins": { ".validate": "newData.isBoolean()" },
          "notifyFreq": { ".validate": "newData.isString() && (newData.val() === 'low' || newData.val() === 'normal' || newData.val() === 'high')" },
          "quietFrom": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23" },
          "quietTo": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23" },
          "$other": { ".validate": false }
        }
      }
    },

    "leaderboard": {
      ".read": "auth != null",
      ".indexOn": ["ep", "nameLower"]
    },

    "weeklyBoard": {
      "$week": {
        ".read": "auth != null",
        ".indexOn": ["ep"]
      }
    },

    "devices": {
      ".read": "auth != null",
      "$deviceId": {
        ".write": "auth != null && auth.token.device === true"
      }
    },

    "rewards": {
      ".read": "auth != null"
    },

    "globalNotifications": {
      ".read": "auth != null",
      ".indexOn": ["ts"]
    },

    "qrNonces": { ".indexOn": ["exp"] }
  }
}
