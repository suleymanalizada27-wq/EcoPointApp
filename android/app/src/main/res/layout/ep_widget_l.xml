<FrameLayout android:layout_width="0dp" android:layout_height="7dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/ep_widget_seg_off"><LinearLayout android:id="@+id/ep_widget_seg_3" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ep_widget_seg_on" android:visibility="gone" /></FrameLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="7dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/ep_widget_seg_off"><LinearLayout android:id="@+id/ep_widget_seg_4" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ep_widget_seg_on" android:visibility="gone" /></FrameLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="7dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/ep_widget_seg_off"><LinearLayout android:id="@+id/ep_widget_seg_5" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ep_widget_seg_on" android:visibility="gone" /></FrameLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="7dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/ep_widget_seg_off"><LinearLayout android:id="@+id/ep_widget_seg_6" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ep_widget_seg_on" android:visibility="gone" /></FrameLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="7dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/ep_widget_seg_off"><LinearLayout android:id="@+id/ep_widget_seg_7" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ep_widget_seg_on" android:visibility="gone" /></FrameLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="7dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/ep_widget_seg_off"><LinearLayout android:id="@+id/ep_widget_seg_8" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ep_widget_seg_on" android:visibility="gone" /></FrameLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="7dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/ep_widget_seg_off"><LinearLayout android:id="@+id/ep_widget_seg_9" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ep_widget_seg_on" android:visibility="gone" /></FrameLayout>
</LinearLayout>
<TextView android:id="@+id/ep_widget_goal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/ef_w_sub" android:shadowColor="#80000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="3" android:textSize="11sp" android:text="" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</FrameLayout>
