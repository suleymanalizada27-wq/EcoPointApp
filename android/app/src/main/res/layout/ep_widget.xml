<?xml version="1.0" encoding="utf-8"?>
<!-- Duolingo-style EcoFriend widget. Only FrameLayout / LinearLayout / TextView / ImageView (RemoteViews-safe). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ep_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ep_widget_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
<ImageView android:id="@+id/ep_widget_mascot" android:layout_width="92dp" android:layout_height="match_parent" android:background="@drawable/ep_widget_halo" android:contentDescription="EcoFriend" android:scaleType="fitCenter" android:src="@drawable/ecofriend_normal" />
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center_vertical" android:orientation="vertical">
<TextView android:id="@+id/ep_widget_msg" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ep_widget_bubble" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="2" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="" android:textStyle="bold" android:textColor="@color/ef_w_ink" android:textSize="11sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
<TextView android:id="@+id/ep_widget_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:text="—" android:textStyle="bold" android:textColor="@color/ef_w_text" android:shadowColor="#80000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="3" android:textSize="26sp" />
<TextView android:id="@+id/ep_widget_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="3dp" android:includeFontPadding="false" android:textStyle="bold" android:text="EP" android:textColor="@color/ef_w_lime"  android:textSize="12sp" />
</LinearLayout>
<TextView android:id="@+id/ep_widget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:text="EcoPoint" android:textColor="@color/ef_w_sub" android:shadowColor="#80000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="3" android:textSize="10sp" />
</LinearLayout>
<LinearLayout android:id="@+id/ep_widget_streak_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/ep_widget_chip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp">
<ImageView android:id="@+id/ep_widget_flame" android:layout_width="14dp" android:layout_height="14dp" android:importantForAccessibility="no" android:src="@drawable/ep_widget_flame" />
<TextView android:id="@+id/ep_widget_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/ef_w_flame" android:textSize="14sp" android:text="" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</FrameLayout>
